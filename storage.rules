rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public game art consumed by the static web app.
    match /war3-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
